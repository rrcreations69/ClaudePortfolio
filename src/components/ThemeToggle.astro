---
/**
 * ThemeToggle — ISLAND 2 of 3. Ships in CHUNK 12 per D8.
 *
 * HOW IT SATISFIES THE FIVE INTERACTION RULES
 * -------------------------------------------
 * 1. Keyboard: a real <button>. Nothing custom, focus ring inherited.
 * 2. JS disabled: the button is HIDDEN until the island unhides it. A toggle
 *    that does nothing is worse than no toggle, and theme switching is
 *    genuinely non-essential — prefers-color-scheme still works, so a visitor
 *    without JavaScript gets the correct theme, just not an override.
 * 3. Reduced motion: no transition on the theme change at all. Colours are
 *    not animated anywhere in this design system — the rule permits opacity
 *    and transform only — so the switch is instant by design, not by
 *    exception.
 * 4. 320px / 44×44: fixed 44×44 target.
 * 5. Easier to reach: it only changes presentation, never hides content.
 *
 * Both icons are rendered and CSS shows the applicable one, so the correct
 * icon is present in the server-rendered HTML rather than being painted in by
 * JavaScript afterwards.
 */
---

<button
  type="button"
  class="themetoggle"
  data-theme-toggle
  hidden
  aria-label="Switch colour theme"
>
  {/* Decorative: the accessible name comes from aria-label, which the island
      keeps accurate as the theme changes. */}
  <svg
    class="themetoggle__icon themetoggle__icon--sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>

  <svg
    class="themetoggle__icon themetoggle__icon--moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .themetoggle {
    /* 44×44 — interaction rule 4. */
    inline-size: 44px;
    block-size: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--text-muted);
    cursor: pointer;
  }

  /* `hidden` must win over the flex display above, or the button would show
     for visitors without JavaScript. */
  .themetoggle[hidden] {
    display: none;
  }

  .themetoggle:hover {
    color: var(--text);
    border-color: var(--border);
    background-color: var(--surface);
  }

  .themetoggle:focus-visible {
    outline: var(--focus-width) solid var(--accent);
    outline-offset: var(--focus-offset);
  }

  /* Show the icon for the theme you would switch TO, so the control says what
     it does rather than what is currently true. Driven entirely by CSS, so
     the right icon is in the server-rendered HTML from the start. */
  .themetoggle__icon--sun {
    display: none;
  }

  .themetoggle__icon--moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .themetoggle__icon--sun {
      display: block;
    }
    :root:not([data-theme='light']) .themetoggle__icon--moon {
      display: none;
    }
  }

  :root[data-theme='dark'] .themetoggle__icon--sun {
    display: block;
  }
  :root[data-theme='dark'] .themetoggle__icon--moon {
    display: none;
  }

  :root[data-theme='light'] .themetoggle__icon--sun {
    display: none;
  }
  :root[data-theme='light'] .themetoggle__icon--moon {
    display: block;
  }
</style>

<script>
  /**
   * ISLAND 2 of 3 — theme toggle.
   *
   * Everything before this point already works: tokens.css resolves the OS
   * preference, and public/theme-init.js applies a stored override before
   * paint. This script adds only the ability to CHANGE the choice.
   */
  function initThemeToggle(): void {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'),
    );
    if (buttons.length === 0) return;

    const root = document.documentElement;

    /** What is actually being displayed right now. */
    const currentTheme = (): 'light' | 'dark' => {
      const explicit = root.getAttribute('data-theme');
      if (explicit === 'light' || explicit === 'dark') return explicit;
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';
    };

    /** The label names the ACTION, not the current state. */
    const syncLabels = (): void => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      for (const button of buttons) {
        button.setAttribute('aria-label', `Switch to ${next} theme`);
      }
    };

    for (const button of buttons) {
      // Only now does the control become visible: with JavaScript off it
      // stays hidden rather than sitting there doing nothing.
      button.hidden = false;

      button.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          window.localStorage.setItem('theme', next);
        } catch {
          // Storage unavailable. The choice still applies to this page; it
          // just will not survive navigation. Better than throwing.
        }
        syncLabels();
      });
    }

    syncLabels();

    // If the visitor has NOT chosen explicitly, follow the OS when it changes.
    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        if (!root.hasAttribute('data-theme')) syncLabels();
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle, {
      once: true,
    });
  } else {
    initThemeToggle();
  }
</script>
