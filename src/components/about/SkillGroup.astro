---
/**
 * SkillGroup — one category of skills.
 *
 * NO proficiency indicator of any kind. Where a skill has published evidence
 * it links to it; where it does not, it is plain text. That absence is honest:
 * a skill with no case study behind it is a claim with no support, and the
 * page does not dress it up as anything more.
 */
import type { SkillCategory } from '../../data/skills';
import Link from '../Link.astro';

interface Props {
  group: SkillCategory;
}

const { group } = Astro.props;
---

<div class="group">
  <h3 class="group__name">{group.category}</h3>
  <ul class="group__list">
    {
      group.skills.map((skill) => (
        <li class="group__skill">
          {skill.evidence.length > 0 ? (
            <Link href={`/work/${skill.evidence[0]}`}>{skill.name}</Link>
          ) : (
            skill.name
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .group__name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-normal);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .group__list {
    margin-block-start: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    list-style: none;
    padding: 0;
  }

  .group__skill {
    font-size: var(--text-sm);
  }

  /* Drawn separator, so it is never announced. */
  .group__skill + .group__skill::before {
    content: '';
    display: inline-block;
    inline-size: 3px;
    block-size: 3px;
    margin-inline-end: var(--space-3);
    border-radius: 50%;
    background-color: var(--border-strong);
    vertical-align: middle;
  }
</style>
