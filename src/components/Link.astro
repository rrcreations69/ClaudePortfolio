---
/**
 * Link — the only anchor element this site should use for outbound links.
 *
 * Per CLAUDE.md §Security, `rel="noopener noreferrer"` is *enforced here*
 * rather than left to whoever writes the next page. External links are
 * detected from the href, so getting it wrong requires bypassing this
 * component deliberately.
 *
 * - noopener  stops the opened page reaching back via window.opener
 * - noreferrer stops the destination learning where the visitor came from,
 *   which also matters for confidentiality: referrer headers leak URLs.
 *
 * Anything the caller passes in rel is merged, never replaced.
 */
interface Props {
  href: string;
  class?: string;
  rel?: string;
  target?: string;
  'aria-current'?: 'page' | 'true' | undefined;
  [key: string]: unknown;
}

const { href, class: className, rel, target, ...rest } = Astro.props;

// Anything not starting with "/" or "#" leaves this origin. mailto: and tel:
// are external but open no window, so they need no rel.
const isExternal = /^https?:\/\//i.test(href);
const isProtocolLink = /^(mailto|tel):/i.test(href);

const relTokens = new Set((rel ?? '').split(/\s+/).filter(Boolean));
if (isExternal) {
  relTokens.add('noopener');
  relTokens.add('noreferrer');
}

const finalRel = relTokens.size > 0 ? [...relTokens].join(' ') : undefined;

// External links open in a new tab unless told otherwise; internal ones never
// do. Opening internal links in new tabs takes control away from the visitor.
const finalTarget = target ?? (isExternal ? '_blank' : undefined);
---

<a href={href} class={className} rel={finalRel} target={finalTarget} {...rest}>
  <slot />
  {isExternal && finalTarget === '_blank' && (
    <span class="visually-hidden">(opens in a new tab)</span>
  )}
  {isProtocolLink && null}
</a>
