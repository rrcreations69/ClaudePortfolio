---
/**
 * StageCoverage — which of the seven delivery stages this project covered.
 *
 * ────────────────────────────────────────────────────────────────────────────
 * WHY THIS EXISTS. `stages` was in the schema from CHUNK 04 and rendered
 * nowhere until 2026-09-24, which made it a claim stored in a file nobody
 * reads. The schema's own comment said it "drives the Delivery Thread rail" —
 * it did not. The rail is built from the rendered headings.
 *
 * That gap mattered because the *comparison* is the argument. One project
 * lighting seven stages beside one lighting four says "requirement to support"
 * far more credibly than a sentence claiming it, precisely because the reader
 * can see the one that does NOT span the whole thing. A page that only ever
 * showed covered stages would be marketing.
 * ────────────────────────────────────────────────────────────────────────────
 *
 * NO JAVASCRIPT. A static list of seven items, in delivery order.
 *
 * ACCESSIBILITY — coverage is conveyed THREE ways, never by colour alone:
 *   1. the marker is filled vs hollow (shape, survives greyscale)
 *   2. the label is --text vs --text-muted (both AAA against --bg and
 *      --surface; see the token table in CLAUDE.md)
 *   3. a visually-hidden "covered" / "not covered" after every label, so a
 *      screen reader gets the state rather than seven bare nouns
 *
 * ⚠️ DO NOT dim uncovered stages with `opacity`. It has broken AAA contrast
 * twice on this site: opacity blends the computed colour toward the
 * background, and axe cannot see it because the declared token still passes.
 * Uncovered items use a different TOKEN, not a faded one.
 *
 * Accent on the covered marker is deliberate and permitted — CLAUDE.md allows
 * accent for "the Delivery Thread marker", which is exactly what this is.
 */
import { DELIVERY_STAGES } from '../../content/schema.ts';
import { STAGE_LABEL, type DeliveryStage } from '../../lib/caseStudy.ts';

interface Props {
  stages: readonly DeliveryStage[];
}

const { stages } = Astro.props;

const covered = DELIVERY_STAGES.filter((s) => stages.includes(s)).length;
const total = DELIVERY_STAGES.length;
---

<section class="cov" aria-labelledby="cov-heading">
  <h2 id="cov-heading" class="cov__heading">
    Delivery stages — {covered} of {total}
  </h2>

  <ol class="cov__list">
    {
      DELIVERY_STAGES.map((stage) => {
        const isCovered = stages.includes(stage);
        return (
          <li class:list={['cov__item', isCovered && 'is-covered']}>
            <span class="cov__marker" aria-hidden="true" />
            <span class="cov__label">{STAGE_LABEL[stage]}</span>
            <span class="visually-hidden">
              {isCovered ? ' — covered' : ' — not covered'}
            </span>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .cov {
    max-width: var(--width-prose);
  }

  /* Matches the `dt` treatment in CaseStudyHeader so this reads as another
     field of the evidence block rather than a new kind of thing. */
  .cov__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-block-end: var(--space-3);
  }

  .cov__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cov__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Shape, not just colour: hollow ring for uncovered, solid for covered.
     Survives greyscale printing and colour-blind viewing. */
  .cov__marker {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    background-color: transparent;
  }

  .is-covered .cov__marker {
    border-color: var(--accent);
    background-color: var(--accent);
  }

  .cov__label {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .is-covered .cov__label {
    color: var(--text);
    font-weight: 500;
  }
</style>
