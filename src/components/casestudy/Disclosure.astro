---
/**
 * Disclosure — progressive depth via native <details>.
 *
 * Per §5.3: deeper technical material sits behind a disclosure labelled with
 * what it contains, e.g. "Technical detail — dependency resolution". A
 * technical reader expands exactly the depth they want; everyone else is not
 * given a wall of text.
 *
 * Native <details>/<summary> deliberately, not a JS accordion:
 *  - zero JavaScript
 *  - keyboard operable and announced correctly with no ARIA at all
 *  - browsers open it automatically for find-in-page and for print
 *
 * THE RULE THAT MATTERS: never hide essential content in here. The summary
 * must stand alone, and the case study must still make sense with every
 * disclosure closed. This is for depth, never for the substance.
 */
interface Props {
  /** Must describe the contents. Never "Read more" or "Details". */
  summary: string;
}

const { summary } = Astro.props;
---

<details class="disclosure">
  <summary class="disclosure__summary">{summary}</summary>
  <div class="disclosure__body">
    <slot />
  </div>
</details>

<style>
  .disclosure {
    margin-block: var(--space-8);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
    background-color: var(--surface);
  }

  .disclosure__summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* ≥44px target — interaction rule 4 */
    min-block-size: 44px;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    /* Removes the default triangle so a consistent marker can be drawn;
       ::-webkit-details-marker covers older Safari. */
    list-style: none;
  }

  .disclosure__summary::-webkit-details-marker {
    display: none;
  }

  /* The marker is drawn, not typed, so a screen reader never announces it —
     the open/closed state is already conveyed by <details> itself. */
  .disclosure__summary::before {
    content: '';
    flex: none;
    inline-size: 0;
    block-size: 0;
    border-block-start: 5px solid transparent;
    border-block-end: 5px solid transparent;
    border-inline-start: 7px solid var(--text-muted);
    transition: transform var(--duration-fast) var(--ease);
  }

  .disclosure[open] .disclosure__summary::before {
    transform: rotate(90deg);
  }

  .disclosure__summary:focus-visible {
    outline: var(--focus-width) solid var(--accent);
    outline-offset: -2px;
  }

  .disclosure__body {
    padding: 0 var(--space-4) var(--space-4);
  }

  .disclosure__body > :global(* + *) {
    margin-block-start: var(--space-4);
  }
</style>
