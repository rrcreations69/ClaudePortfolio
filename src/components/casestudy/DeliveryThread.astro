---
/**
 * DeliveryThread — the sticky rail on a case study. Signature element 1.
 *
 * It is a <nav> of anchor links, nothing more. Each section of the case study
 * is labelled with the delivery stage it belongs to, so the reader can see at
 * a glance that the story runs from requirement through to support.
 *
 * ACCESSIBILITY AND DEGRADATION — this is the whole design:
 *  - With JavaScript disabled it is a plain table of contents. Every link
 *    works, because they are real anchors to real ids.
 *  - The island (see below) only *adds* `aria-current` as you scroll. Nothing
 *    is hidden pending it, and losing it costs a highlight, not a destination.
 *  - Under prefers-reduced-motion the global kill switch turns smooth
 *    scrolling off; the links still jump correctly.
 *  - On narrow screens it is not sticky and sits above the content as an
 *    ordinary contents list, because a sticky rail on a phone eats the screen.
 */
import type { ThreadItem } from '../../lib/caseStudy.ts';

interface Props {
  items: readonly ThreadItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="thread" aria-labelledby="thread-heading">
      <h2 id="thread-heading" class="thread__heading">
        Delivery thread
      </h2>
      <ol class="thread__list">
        {items.map((item) => (
          <li class="thread__item">
            <a class="thread__link" href={`#${item.slug}`} data-thread-link={item.slug}>
              {item.stageLabel && (
                <span class="thread__stage">{item.stageLabel}</span>
              )}
              <span class="thread__text">{item.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .thread {
    margin-block-end: var(--space-12);
  }

  .thread__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-normal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-block-end: var(--space-4);
  }

  .thread__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-1);
  }

  .thread__item {
    /* The line that makes it a thread. Drawn, not typed, so it is never
       announced by a screen reader. */
    border-inline-start: 2px solid var(--border);
    transition: border-color var(--duration-fast) var(--ease);
  }

  .thread__link {
    display: block;
    padding: var(--space-2) var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    /* ≥44px touch target — interaction rule 4 */
    min-block-size: 44px;
  }

  .thread__link:hover {
    opacity: 1;
    color: var(--text);
  }

  .thread__stage {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    opacity: 0.8;
  }

  .thread__text {
    display: block;
  }

  /* Current section. The marker is one of the four permitted uses of accent.
     Colour is not the only signal — the rule thickens and the text darkens —
     so this still reads without colour perception. */
  .thread__item:has(.thread__link[aria-current='true']) {
    border-inline-start-color: var(--accent);
    border-inline-start-width: 2px;
  }

  .thread__link[aria-current='true'] {
    color: var(--text);
    font-weight: var(--weight-medium);
  }

  @media (min-width: 1024px) {
    .thread {
      position: sticky;
      inset-block-start: var(--space-8);
      margin-block-end: 0;
      /* Never taller than the viewport, so a long thread can still scroll. */
      max-block-size: calc(100dvh - var(--space-16));
      overflow-y: auto;
    }
  }
</style>

<script>
  /**
   * ISLAND 1 of 3 — the delivery thread scroll spy.
   *
   * Sole job: set aria-current on the link for whichever section is currently
   * in view. It adds a highlight to a table of contents that already works.
   * If this script never runs, the rail still navigates correctly.
   *
   * IntersectionObserver, not a scroll handler: no work on the main thread
   * between intersections, which keeps INP clean.
   */
  function initDeliveryThread(): void {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-thread-link]'),
    );
    if (links.length === 0) return;

    const byId = new Map(links.map((link) => [link.dataset.threadLink!, link]));
    const targets = links
      .map((link) => document.getElementById(link.dataset.threadLink!))
      .filter((el): el is HTMLElement => el !== null);
    if (targets.length === 0) return;

    const visible = new Set<string>();

    const setCurrent = (id: string | null): void => {
      for (const link of links) {
        if (link.dataset.threadLink === id) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }

        // Highlight the topmost section currently in view. When nothing is
        // intersecting — scrolled past the last heading — keep the last
        // highlight rather than clearing it, which would flicker.
        const firstVisible = targets.find((t) => visible.has(t.id));
        if (firstVisible && byId.has(firstVisible.id)) {
          setCurrent(firstVisible.id);
        }
      },
      {
        // Trigger when a heading reaches the upper third of the viewport,
        // which is where a reader's attention actually is.
        rootMargin: '-10% 0px -70% 0px',
        threshold: 0,
      },
    );

    for (const target of targets) observer.observe(target);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDeliveryThread, { once: true });
  } else {
    initDeliveryThread();
  }
</script>
