---
/**
 * Contact — CHUNK 11.
 *
 * Per D6: links only. No form, no form backend, no analytics, and therefore
 * zero third-party origins — which is what keeps the CSP strict and means
 * there is no consent UI, no spam handling and no API key to leak.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/contact/ContactBlock.astro';
import { site } from '../data/site';

// Indexable only once there is at least one way to actually reach him.
const reachable = site.contact.email !== null || site.contact.linkedin !== null;
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name}, ${site.role}.`}
  noindex={!reachable}
  prose
>
  <h1>Contact</h1>

  <p class="lead">
    The quickest way to reach me is below. I read everything, and I reply to
    anything specific.
  </p>

  {site.availability && <p class="where">{site.availability}</p>}

  <ContactBlock />
</BaseLayout>

<style>
  .lead {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  .where {
    margin-block-start: var(--space-4);
    color: var(--text-muted);
  }

  /* The block manages its own spacing; this just separates it from the intro. */
  :global(.contact) {
    margin-block-start: var(--space-12);
  }
</style>
