---
/**
 * Home — CHUNK 03 placeholder.
 *
 * The real home page is CHUNK 08 (hero) and CHUNK 09 (delivery thread,
 * selected work, experience teaser). This exists so the shell has somewhere to
 * live and can be navigated end to end.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Link from '../components/Link.astro';
import { site } from '../data/site';
---

<BaseLayout title={site.name} noindex prose>
  <h1>{site.name}</h1>
  <p class="lead">{site.role}</p>
  <p>
    Requirements to release, and everything after.
    <!-- [VERIFY INFORMATION] Positioning line (CG-09) not yet chosen — this is
         Option 3 from PHASE-1-DISCOVERY.md §10.1, shown as a placeholder only.
         Replace in CHUNK 08 with whichever option Raymund picks. -->
  </p>
  <p>
    This site is under construction. The foundation, security headers, design
    system and global shell are in place. Content follows.
  </p>
  <p>
    <Link href="/styleguide">View the design system</Link>
  </p>
</BaseLayout>

<style>
  .lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
</style>
