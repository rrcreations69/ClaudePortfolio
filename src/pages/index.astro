---
/**
 * Home — CHUNK 08 (hero) and CHUNK 09 (thread, selected work, experience).
 *
 * The page is `noindex` until it carries real content. Indexing a page full of
 * [CONTENT REQUIRED] markers would put those markers in search results, which
 * is a worse first impression than not being indexed at all.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import DeliveryThreadStrip from '../components/home/DeliveryThreadStrip.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import ExperienceTeaser from '../components/home/ExperienceTeaser.astro';
import { site } from '../data/site';
import { experience } from '../data/experience';

const projects = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);

// Fall back to all projects if none are flagged featured — an empty
// "Selected work" section when projects exist would be a silent bug.
const selected = featured.length > 0 ? featured : projects;

// The page is ready to index only when it has the positioning line AND at
// least one case study. Both are content, not code.
const hasRealContent = site.positioning !== null && projects.length > 0;
---

<BaseLayout
  title={site.name}
  description={site.positioning ?? undefined}
  noindex={!hasRealContent}
>
  <Hero positioning={site.positioning} availability={site.availability} />

  <DeliveryThreadStrip />

  <SelectedWork projects={selected} totalCount={projects.length} />

  <ExperienceTeaser roles={experience} />
</BaseLayout>
