---
// CHUNK 01/02 placeholder.
// Proves the toolchain, the deploy pipeline, the security headers and now the
// design system. The real home page is CHUNK 08 (hero) and CHUNK 09 (thread,
// selected work, experience teaser).
//
// The document wrapper is inline here deliberately. Extracting it into a
// BaseLayout with header, nav and footer is CHUNK 03 — the global shell.
import { Font } from 'astro:assets';
import '../styles/global.css';

const buildDate = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Raymund Bermudes — Portfolio (in development)</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell" style="padding-block: var(--space-24);">
      <main id="main" class="prose">
        <h1>Raymund Ryan Bermudes</h1>
        <p style="color: var(--text-muted); font-size: var(--text-lg);">
          Solution Analyst &amp; Android Developer.
        </p>
        <p>
          This site is under construction. The project foundation, deploy
          pipeline, security headers and design system are in place. Content
          follows.
        </p>
        <p>
          <a href="/styleguide">View the design system</a>
        </p>
        <p><small>Build {buildDate}</small></p>
      </main>
    </div>
  </body>
</html>
