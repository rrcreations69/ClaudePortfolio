---
/**
 * Work index — CHUNK 05.
 *
 * Lists every project as an evidence card, ordered by the curated `order`
 * field rather than by date. Newest-first is a blog convention; a portfolio
 * should lead with its strongest work.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/work/ProjectGrid.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';

const projects = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);

const hasProjects = projects.length > 0;
---

<BaseLayout
  title="Work"
  description="Case studies in enterprise systems delivery, Android maintenance and production support."
  noindex={!hasProjects}
  prose={!hasProjects}
>
  <div class="intro">
    <h1>Work</h1>
    <p>
      Each case study covers one piece of production work: the problem, what I
      personally did, how I investigated it, and how the result was validated.
    </p>
  </div>

  {
    hasProjects ? (
      <div class="wide">
        <ProjectGrid>
          {projects.map((project) => (
            <li>
              <ProjectCard
                slug={project.data.slug}
                title={project.data.title}
                clientDescriptor={project.data.clientDescriptor}
                disclosure={project.data.disclosure}
                period={project.data.period}
                problem={project.data.problem}
                myRole={project.data.myRole}
                outcome={project.data.outcome}
                stack={project.data.stack}
              />
            </li>
          ))}
        </ProjectGrid>
      </div>
    ) : (
      <p class="pending">
        <strong>[CONTENT REQUIRED]</strong> The content layer is wired and the
        collection is queryable — it is simply empty. Case study content is
        CHUNK 07, blocked on CHUNK 00 (content and confidentiality clearance).
        No placeholder project is committed, because a fabricated case study
        would be worse than an empty page.
      </p>
    )
  }
</BaseLayout>

<style>
  .intro {
    max-width: var(--width-prose);
    margin-block-end: var(--space-12);
  }

  .intro p {
    margin-block-start: var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .pending {
    max-width: var(--width-prose);
    padding: var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
