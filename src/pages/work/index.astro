---
/**
 * Work index — CHUNK 04 wiring.
 *
 * Reads the collection so the content layer is proven end to end rather than
 * merely defined. The real index — ProjectCard, the evidence block, ordering
 * and featured handling — is CHUNK 05; this renders the honest empty state
 * until there is something to list.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Work"
  description="Case studies in enterprise Android development and maintenance."
  noindex
  prose
>
  <h1>Work</h1>
  <p>
    Case studies are in preparation. Each one covers a single piece of
    production work: the problem, what I personally did, how it was
    investigated, and how the fix was validated.
  </p>

  {
    projects.length === 0 ? (
      <p class="pending">
        <strong>[CONTENT REQUIRED]</strong> The content layer is wired and the
        collection is queryable — it is simply empty. Case study content is
        CHUNK 07, blocked on CHUNK 00 (content and confidentiality clearance).
        No placeholder project is committed, because a fabricated case study
        would be worse than an empty page.
      </p>
    ) : (
      <ul>
        {projects.map((project) => (
          <li>
            <a href={`/work/${project.data.slug}`}>{project.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .pending {
    padding: var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
